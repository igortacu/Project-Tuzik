# Path to the Obsidian vault to index/query.
OBSIDIAN_VAULT_PATH=

# OpenRouter API key, used for the free-tier model tried first by LLMClient.
OPENROUTER_API_KEY=

# API key for the configured paid fallback model (provider depends on FALLBACK_MODEL_ID).
PAID_MODEL_API_KEY=

# Base URL for a local Ollama instance, used as the final fallback tier.
OLLAMA_BASE_URL=http://localhost:11434

# Telegram bot token from @BotFather (message it /newbot on Telegram).
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user ids allowed to use the bot, e.g. "12345678".
# Leave empty, message the bot once, and it'll reply with your user id.
TELEGRAM_ALLOWED_USER_IDS=

# Optional: silences the "unauthenticated requests to the HF Hub" warning
# from sentence-transformers and raises the download rate limit. Not read by
# any of our code directly -- huggingface_hub picks it up from the
# environment on its own once python-dotenv loads this file. Get a free
# read-only token at https://huggingface.co/settings/tokens.
HF_TOKEN=
